# Agent Ground — Pollinations API key (BYOP). Never commit the real value.
# Create a key at https://enter.pollinations.ai/keys (or sign in with the
# dashboard's Connect button — the key never touches disk there).
POLLINATIONS_KEY=
# Hard Pollen ceiling for all metered calls (1 Pollen = $1 of balance).
MAX_POLLEN_BUDGET=5
# Optional: publish the demo project live (mcp-publish tools).
# Tokens are read from the environment only — never written to workspaces or Git.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EDGEONE_API_TOKEN=
# Ports (defaults shown).
AGENT_GROUND_PORT=8877
AGENT_BYOP_PORT=8878
# Inference base (override for offline tests; do not change in production).
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
