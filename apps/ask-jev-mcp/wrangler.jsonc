{
  "name": "ask-jev-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "ask-jev-mcp.pollinations.ai",
      "zone_name": "pollinations.ai",
      "custom_domain": true
    }
  ],
  // Per client IP, before tool calls reach Gen and Enter's D1 — the same
  // guard the sibling pollinations-mcp worker installs on its public
  // custom domain; namespace 1007 is the account's MCP rate-limit
  // namespace (the sibling documents staging as sharing it).
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 200, "period": 10 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "ask-jev-mcp-staging",
      // Keep direct staging access alongside the Gen service binding.
      "workers_dev": true,
      "routes": [],
      "vars": { "POLLINATIONS_BASE_URL": "https://staging.gen.pollinations.ai" },
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 200, "period": 10 }
        }
      ],
      "observability": { "enabled": true }
    }
  }
}
