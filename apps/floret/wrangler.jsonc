{
  "name": "floret",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "containers": [
    {
      "class_name": "FloretContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FLORET", "class_name": "FloretContainer" },
      { "name": "FLORET_CATALOG", "class_name": "FloretCatalog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FloretContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["FloretShellContainer", "FloretCatalog"] },
    { "tag": "v3", "deleted_classes": ["FloretShellContainer"] }
  ],
  // Existing custom domains are Dashboard-managed. Omit routes so deployments
  // preserve their bindings without requiring zone-edit permissions.
  // Per client IP, before any chat POST costs an Enter D1 auth read or any
  // anonymous request queues into the shared container — the same guard the
  // sibling pollinations-mcp worker installs on its public custom domain;
  // namespace 1007 is the account's MCP rate-limit namespace (the sibling
  // documents staging as sharing it).
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 200, "period": 10 }
    }
  ],
  "observability": { "enabled": true }
}
