[Unit]
Description=Community Model Monitor Loop
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/monitor
# No EnvironmentFile: secrets stay out of the service environment. loop.sh
# sources .env without exporting and exports only DISCORD_TOKEN (required by
# the mcp-discord server); probe.mjs and the leaderboard builders use
# `node --env-file`, and tb-query.sh reads .env itself.
ExecStartPre=-/home/ubuntu/monitor/update-from-repo.sh
ExecStart=/home/ubuntu/monitor/loop.sh
Restart=always
RestartSec=1800
RuntimeMaxSec=2700
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
